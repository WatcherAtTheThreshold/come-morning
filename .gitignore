# Godot 4
.godot/
/android/

# Godot export output
/build/
*.pck
*.exe
*.zip

# Blender
*.blend1
*.blend2

# OS
Thumbs.db
desktop.ini
.DS_Store

# Blender autosaves. Never tracked.
*.blend[0-9]
blender-wip/

# Working .blend files DO belong in this repo — Godot imports them directly
# from res://, so a .blend outside the project cannot be a source asset.
# Ignored by default so a stray save elsewhere stays out, allowed under assets/.
*.blend
!assets/**/*.blend
